---
import Layout from "../../layouts/Layout.astro";
import PluginDetail from "../../components/plugins/PluginDetail";
import { getPluginRegistry } from "../../lib/plugins.server";

export const prerender = false;
const { registry, error } = await getPluginRegistry();
const id = Astro.params.id ?? "";
const plugin = registry?.plugins.find((candidate) => candidate.id === id);
if (!plugin && !error) Astro.response.status = 404;
---

<Layout
  title={plugin ? `${plugin.name} — Hive Plugin Store` : "Plugin unavailable — Hive"}
  description={plugin?.description ?? "This plugin is not currently available in Hive's published registry."}
>
  {plugin ? (
    <PluginDetail client:load plugin={plugin} />
  ) : (
    <main class="grid min-h-screen place-items-center bg-[#0F0F0E] px-6 text-center text-bone">
      <div class="max-w-lg">
        <div class="font-mono text-[10px] tracking-[.14em] text-[#89857B]">
          {error ? "REGISTRY UNAVAILABLE" : "PLUGIN NOT FOUND"}
        </div>

        <h1 class="mt-5 text-[clamp(28px,4vw,42px)] leading-[1.08] font-medium tracking-[-.04em]">
          {error ? "Couldn't load this plugin." : "This plugin isn't in the published catalog."}
        </h1>

        <p class="mx-auto mt-4 max-w-md text-[14px] leading-relaxed text-[#A9A59B]">
          Installable listings come only from Hive's published registry. Community discovery
          does not make a plugin installable.
        </p>

        <div class="mt-8 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
          <a
            class="inline-flex h-11 items-center bg-honey px-5 font-mono text-[11px] font-medium tracking-[.1em] text-[#14120d] hover:bg-[#ffc85a]"
            href="/plugins"
          >
            BROWSE ALL PLUGINS
          </a>
          <a
            class="inline-flex h-11 items-center border border-bone/15 px-4 font-mono text-[11px] tracking-[.08em] text-[#D0CCC2] hover:border-honey/50"
            href="/docs/config/plugins/"
          >
            PLUGIN SAFETY GUIDE ↗
          </a>
        </div>
      </div>
    </main>
  )}
</Layout>
