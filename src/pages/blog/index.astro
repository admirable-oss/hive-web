---
import { getCollection } from 'astro:content';
import BlogFrame from '../../components/blog/BlogFrame.astro';
import BlogHero from '../../components/blog/BlogHero.astro';
import BlogPostCard from '../../components/blog/BlogPostCard.astro';
import BlogPagination from '../../components/blog/BlogPagination.astro';
import BlogGithubCta from '../../components/blog/BlogGithubCta.astro';
import BlogSortControl from '../../components/blog/BlogSortControl.astro';
import { BLOG_PAGE_SIZE, categoriesFor, publishedPosts, categoryUrl } from '../../lib/blog';
const posts = publishedPosts(await getCollection('blog'));
const categories = categoriesFor(posts);
const totalPages = Math.ceil(posts.length / BLOG_PAGE_SIZE);
const pagePosts = posts.slice(0, BLOG_PAGE_SIZE);
const canonical = new URL('/blog/', Astro.site).href;
const jsonLd = { '@context': 'https://schema.org', '@type': 'CollectionPage', name: 'Hive Blog', description: 'Ideas, experiments, and engineering behind Hive.', url: canonical, isPartOf: { '@type': 'Blog', name: 'Hive Field Notes', url: canonical } };
---
<BlogFrame title="Hive Blog — Ideas and engineering behind Hive" description="Deep dives into persistent coding agents, developer infrastructure, agent orchestration, and the systems that keep software moving." canonical={canonical} jsonLd={jsonLd}>
  <BlogHero count={posts.length} />
  <main class="blog-main">
    <div class="blog-layout">
      <aside class="category-sidebar" aria-label="Article categories">
        <p class="browse-heading">BROWSE / {posts.length}</p>
        <nav class="category-list">
          <a href="/blog" aria-current="page"><span>All articles</span><span>{posts.length}</span></a>
          {categories.map((category) => <a href={categoryUrl(category.slug)}><span>{category.name}</span><span>{category.count}</span></a>)}
        </nav>
      </aside>
      <section aria-label="Latest articles">
        <nav class="mobile-categories" aria-label="Filter articles by category">
          <a href="/blog" aria-current="page">All / {posts.length}</a>
          {categories.map((category) => <a href={categoryUrl(category.slug)}>{category.name} / {category.count}</a>)}
        </nav>
        <BlogSortControl posts={posts} base="/blog" />
        {pagePosts.length ? <div class="post-grid">{pagePosts.map((post) => <BlogPostCard post={post} featured />)}</div> : <p class="empty-state">No articles have been published yet. Check back soon.</p>}
        <BlogPagination current={1} total={totalPages} base="/blog" />
        <BlogGithubCta />
      </section>
    </div>
  </main>
</BlogFrame>
