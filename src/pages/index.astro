---
import Layout from "../layouts/Layout.astro";
import Preloader from "../components/preloader/Preloader";
import SiteHeader from "../components/header/SiteHeader";
import Hero from "../components/hero/Hero";
---

<Layout lockScroll>
  <Preloader client:load mode="always" />
  <main
    class="relative h-dvh overflow-hidden bg-[radial-gradient(ellipse_95%_80%_at_50%_44%,#1E1E1C_0%,#151514_52%,#0C0C0B_100%)] font-sans text-bone"
  >
    <SiteHeader client:load />
    <Hero client:load />
  </main>
</Layout>
