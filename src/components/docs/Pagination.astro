---
const { prev, next } = Astro.locals.starlightRoute.pagination;
---

{
  (prev || next) && (
    <nav aria-label="Pagination" class="pager print:hidden">
      {prev && (
        <a href={prev.href} rel="prev">
          <span class="dir">{Astro.locals.t("page.previousLink")}</span>
          <span class="label">{prev.label}</span>
        </a>
      )}
      {next && (
        <a href={next.href} rel="next">
          <span class="dir">{Astro.locals.t("page.nextLink")}</span>
          <span class="label">{next.label}</span>
        </a>
      )}
    </nav>
  )
}

<style>
  .pager {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 12px;
  }
  a {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 16px 18px;
    border: 1px solid #1c1c1a;
    color: #edeae3;
    text-decoration: none;
    transition: border-color 160ms, background 160ms;
  }
  a:hover {
    border-color: #2a2926;
    background: #0e0e0d;
    color: #edeae3;
  }
  [rel="next"] {
    grid-column: -2;
    text-align: end;
  }
  .dir {
    font-family: var(--sl-font-mono);
    font-size: 12px;
    color: #8f8b82;
  }
  .label {
    font-size: 16px;
    font-weight: 500;
  }
</style>
