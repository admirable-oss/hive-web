  .github-cta:before{content:"";position:absolute;inset:0 auto 0 0;width:2px;background:#f5b942}
  .github-cta-copy{max-width:590px;position:relative}.github-cta-kicker,.related-kicker{font:500 9px "Geist Mono Variable",monospace;letter-spacing:.14em;color:#b4afa4;text-transform:uppercase;margin:0 0 12px}.github-cta-kicker span{color:#f5b942;margin-right:7px}
  .github-cta h2{font-size:clamp(20px,2.4vw,28px);font-weight:450;letter-spacing:-.035em;margin:0 0 7px;color:#f0ede6}.github-cta-copy>p:last-child{font-size:12px;line-height:1.65;color:#aaa69d;margin:0;max-width:520px}
