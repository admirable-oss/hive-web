---
import { getCollection } from 'astro:content';
import BlogFrame from '../../../components/blog/BlogFrame.astro';
import BlogHero from '../../../components/blog/BlogHero.astro';
import BlogPostCard from '../../../components/blog/BlogPostCard.astro';
import BlogPagination from '../../../components/blog/BlogPagination.astro';
import BlogSortControl from '../../../components/blog/BlogSortControl.astro';
import { BLOG_PAGE_SIZE, publishedPosts, categoriesFor, categoryUrl } from '../../../lib/blog';
export async function getStaticPaths() {
  const posts = publishedPosts(await getCollection('blog'));
  const total = Math.ceil(posts.length / BLOG_PAGE_SIZE);
  return Array.from({ length: Math.max(0, total - 1) }, (_, index) => ({ params: { page: String(index + 2) } }));
}
const allPosts = publishedPosts(await getCollection('blog'));
const page = Number(Astro.params.page);
const totalPages = Math.ceil(allPosts.length / BLOG_PAGE_SIZE);
if (!Number.isInteger(page) || page < 2 || page > totalPages) Astro.response.status = 404;
const posts = allPosts.slice((page - 1) * BLOG_PAGE_SIZE, page * BLOG_PAGE_SIZE);
const categories = categoriesFor(allPosts);
const canonical = new URL(`/blog/page/${page}/`, Astro.site).href;
---
<BlogFrame title={`Hive Blog — Page ${page}`} description={`Hive engineering articles, page ${page}.`} canonical={canonical}>
  <BlogHero count={allPosts.length} eyebrow={`FIELD NOTES / PAGE ${String(page).padStart(2, '0')}`} />
  <main class="blog-main"><div class="blog-layout">
    <aside class="category-sidebar" aria-label="Article categories"><p class="browse-heading">BROWSE / {allPosts.length}</p><nav class="category-list"><a href="/blog"><span>All articles</span><span>{allPosts.length}</span></a>{categories.map((category) => <a href={categoryUrl(category.slug)}><span>{category.name}</span><span>{category.count}</span></a>)}</nav></aside>
    <section aria-label={`Articles, page ${page}`}><nav class="mobile-categories" aria-label="Filter articles by category"><a href="/blog">All / {allPosts.length}</a>{categories.map((category) => <a href={categoryUrl(category.slug)}>{category.name} / {category.count}</a>)}</nav><BlogSortControl posts={allPosts} base="/blog" /><div class="post-grid">{posts.map((post) => <BlogPostCard post={post} />)}</div><BlogPagination current={page} total={totalPages} base="/blog" /></section>
  </div></main>
</BlogFrame>
