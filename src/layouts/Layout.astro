---
import PostHog from '../components/posthog.astro';
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
	canonical?: string;
	image?: string;
	/** Keep the page out of search results (e.g. 404). */
	noindex?: boolean;
	/** Full-viewport pages (the hero) disable document scrolling. */
	lockScroll?: boolean;
}

const {
	title = 'Hive — Coding agents that don’t clock out',
	description = 'Hive is open-source infrastructure that gives every coding agent a persistent runtime — terminal, workspace and context that survive disconnects, reboots and closed laptops.',
	canonical,
	image = '/og-image.png',
	noindex = false,
	lockScroll = false,
} = Astro.props;

const siteUrl = (Astro.site ?? new URL('https://hive.admir-saheta.com')).origin;
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, siteUrl).href;
const imageUrl = new URL(image, siteUrl).href;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />

		<meta
			name="viewport"
			content="width=device-width, initial-scale=1, viewport-fit=cover"
		/>

		<meta name="generator" content={Astro.generator} />
		<PostHog />

		<title>{title}</title>
		<meta name="description" content={description} />

		<meta name="theme-color" content="#0C0C0B" />
		<meta name="color-scheme" content="dark" />

		<link rel="canonical" href={canonicalUrl} />

		<link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<meta name="application-name" content="Hive" />
		<meta name="apple-mobile-web-app-title" content="Hive" />

		<!-- Fonts are self-hosted via @fontsource (see global.css). -->

		<!-- Repeat visit: let CSS hide a mode="once" preloader before first paint. -->
		<script is:inline>
			try {
				if (sessionStorage.getItem('hive-preloaded') === '1') document.documentElement.dataset.preloaded = '';
			} catch (e) {}
		</script>
		<noscript>
			<style>[data-reveal]{opacity:1!important}[data-preloader]{display:none!important}</style>
		</noscript>

		<!-- Open Graph -->
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Hive" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:locale" content="en_US" />
		<meta property="og:image" content={imageUrl} />
		<meta property="og:image:type" content="image/png" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Hive — Coding agents that don’t clock out." />

		<!-- Twitter -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={imageUrl} />
		<meta name="twitter:image:alt" content="Hive — Coding agents that don’t clock out." />

		<!-- Crawlers -->
		<meta
			name="robots"
			content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'}
		/>

		<!-- Structured data -->
		<script type="application/ld+json" set:html={JSON.stringify({
			'@context': 'https://schema.org',
			'@type': 'SoftwareApplication',
			name: 'Hive',
			applicationCategory: 'DeveloperApplication',
			operatingSystem: 'macOS, Linux',
			description,
			url: siteUrl,
			image: imageUrl,
			license: 'https://www.apache.org/licenses/LICENSE-2.0',
			isAccessibleForFree: true,
			offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
			author: {
				'@type': 'Organization',
				name: 'Admirable',
				url: 'https://admir-saheta.com',
			},
		})} />
	</head>

	<body class:list={[lockScroll && 'overflow-hidden overscroll-none']}>
		<slot />
	</body>
</html>