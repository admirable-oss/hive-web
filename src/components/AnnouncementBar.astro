---
import { LINKS } from "../lib/site";
---

<!-- Site-wide announcement above the header. Static: no island, no layout shift. -->
<a
	href={LINKS.desktop}
	data-announcement
	class="group relative z-40 flex h-9 flex-none [@media(max-height:820px)]:h-8 items-center justify-center gap-2.5 overflow-hidden border-b border-bone/8 bg-panel px-4 font-mono text-[11px] tracking-[.06em] whitespace-nowrap text-stone hover:text-stone sm:gap-3"
>
	<span
		aria-hidden
		class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_40%_140%_at_50%_0%,rgb(245_185_66/.13),transparent_70%)]"
	></span>
	<span class="relative bg-honey px-1.5 py-0.5 text-[9px] leading-none font-medium tracking-[.16em] text-ink uppercase">New</span>
	<span class="relative text-bone">Hive Desktop is here</span>
	<span class="relative hidden text-ash md:inline">— your agents in a native window, for macOS, Windows &amp; Linux</span>
	<span class="relative flex items-center gap-1 text-honey uppercase tracking-[.12em] text-[10px]">
		Learn more
		<span aria-hidden class="transition-transform duration-150 ease-[steps(2)] group-hover:translate-x-0.5">→</span>
	</span>
</a>
