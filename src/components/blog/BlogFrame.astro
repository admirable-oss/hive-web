  .article-facts{margin-left:auto;display:flex;align-items:flex-start;justify-content:flex-end;gap:20px;flex-wrap:wrap;text-align:right;font:10px/1.5 "Geist Mono Variable",monospace;color:#c1bdb4}.article-facts span{display:flex;flex-direction:column;gap:4px}.article-facts b{font-size:8px;letter-spacing:.1em;text-transform:uppercase;color:#89867e;font-weight:500}
