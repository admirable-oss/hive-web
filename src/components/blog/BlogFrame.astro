---
import Layout from '../../layouts/Layout.astro';
import BlogHeader from './BlogHeader.astro';
const { title, description, canonical, image, imageAlt, noindex = false, ogType = 'website', jsonLd, publishedTime, modifiedTime } = Astro.props;
---
<Layout title={title} description={description} canonical={canonical} image={image} imageAlt={imageAlt} noindex={noindex} ogType={ogType} jsonLd={jsonLd} publishedTime={publishedTime} modifiedTime={modifiedTime}>
  <div class="blog-site">
    <BlogHeader />
    <slot />
    <footer class="blog-footer"><a href="/blog">HIVE / FIELD NOTES</a><span>Persistent infrastructure for coding agents.</span><a href="https://github.com/admirable-oss/hive">OPEN SOURCE ↗</a></footer>
  </div>
</Layout>

<style is:global>
  .blog-site{min-height:100vh;background:radial-gradient(ellipse 70% 35% at 55% 0%,#191815 0%,#0c0c0b 75%);color:#edeae3;font-family:"Geist Variable",sans-serif}
  .blog-header{height:72px;border-bottom:1px solid rgb(237 234 227 / .09);position:relative;z-index:4;background:rgb(12 12 11 / .76)}
  .blog-header-inner{max-width:1440px;height:100%;margin:auto;padding:0 clamp(20px,5vw,72px);display:flex;align-items:center;gap:clamp(20px,4vw,64px)}
  .blog-logo{display:flex;align-items:center;margin-right:auto}.blog-logo img,.blog-logo svg{height:27px;width:auto}
  .blog-nav{display:flex;align-items:center;gap:clamp(14px,2.4vw,34px)}
  .blog-nav a,.github-link{font:500 11px/1 "Geist Mono Variable",monospace;letter-spacing:.1em;text-transform:uppercase;color:#9b978e;transition:color .18s ease}
  .blog-nav a:hover,.blog-nav .current,.github-link:hover{color:#f5b942}.blog-nav .current{position:relative}.blog-nav .current:after{content:"";position:absolute;left:0;right:0;bottom:-28px;height:1px;background:#f5b942}
  .github-link{padding:10px 12px;border:1px solid #393731;white-space:nowrap}.github-link span{color:#f5b942;margin-left:5px}
  .blog-hero{position:relative;overflow:hidden;border-bottom:1px solid rgb(237 234 227 / .09);min-height:370px;display:flex;align-items:center}
  .hero-atmosphere{position:absolute;inset:0;pointer-events:none;opacity:.82;mask-image:linear-gradient(90deg,transparent 8%,#000 53%,#000 88%,transparent 100%)}
  .hero-atmosphere svg{position:absolute;right:0;top:0;width:min(92vw,1120px);height:100%;overflow:visible}
  .network-lines{stroke-dasharray:4 9;animation:network-drift 48s linear infinite;animation-play-state:paused}.network-nodes{filter:drop-shadow(0 0 5px #f5b94277)}
  .particle-path{stroke-dasharray:1 1000;stroke-dashoffset:0;animation:particle 12s linear infinite;animation-play-state:paused;filter:drop-shadow(0 0 6px #f5b942)}.blog-hero.is-visible .network-lines,.blog-hero.is-visible .particle-path{animation-play-state:running}
  @keyframes network-drift{to{stroke-dashoffset:-156}}
  @keyframes particle{0%{stroke-dasharray:0 1000;stroke-dashoffset:0;opacity:0}12%{opacity:.8}70%{stroke-dasharray:1 1000;stroke-dashoffset:-420;opacity:.5}100%{stroke-dasharray:0 1000;stroke-dashoffset:-1000;opacity:0}}
  .blog-hero-content{position:relative;z-index:1;width:min(1440px,100%);padding:55px clamp(20px,8vw,116px) 53px;margin:auto}
  .eyebrow,.hero-count{font:500 10px/1.4 "Geist Mono Variable",monospace;letter-spacing:.14em;color:#97938a;text-transform:uppercase}
  .eyebrow{display:flex;align-items:center;gap:10px;margin:0 0 22px}.status-dot{width:6px;height:6px;background:#f5b942;box-shadow:0 0 12px #f5b94288}
  .blog-hero h1{font-size:clamp(35px,5.3vw,66px);line-height:1.08;letter-spacing:-.055em;font-weight:450;max-width:760px;margin:0;color:#edeae3}
  .hero-description{color:#aaa69d;max-width:600px;font-size:15px;line-height:1.7;margin:19px 0 23px}
  .hero-count{margin:0;color:#77736a}.hero-count>span:first-child{color:#f5b942}.count-divider{padding:0 9px;color:#55534e}
  .blog-main{max-width:1440px;margin:auto;padding:46px clamp(20px,5vw,72px) 100px}
  .browse-heading{font:500 10px/1.3 "Geist Mono Variable",monospace;color:#77736a;letter-spacing:.13em;text-transform:uppercase;padding:0 0 14px;border-bottom:1px solid #292927;margin:0 0 13px}
  .blog-layout{display:grid;grid-template-columns:190px minmax(0,1fr);gap:clamp(35px,5vw,80px)}
  .category-sidebar{align-self:start;position:sticky;top:24px}.category-list{display:flex;flex-direction:column;gap:2px}
  .category-list a{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:11px 10px;color:#908c83;font-size:12px;border-left:1px solid transparent;transition:background .18s,color .18s,border-color .18s}
  .category-list a span:last-child{font:10px "Geist Mono Variable",monospace;color:#68645c}.category-list a:hover{color:#edeae3;background:#151513}.category-list a[aria-current=page]{color:#f5b942;border-left-color:#f5b942;background:#151513}.category-list a[aria-current=page] span:last-child{color:#c69b4e}
  .mobile-categories{display:none}.post-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}
  .post-card{position:relative;min-width:0;border:1px solid #292927;background:#10100f;transition:border-color .2s,background .2s,transform .2s}.post-card:hover{border-color:#514630;background:#131310;transform:translateY(-2px)}
  .post-card-link{height:100%;min-height:282px;display:flex;flex-direction:column;position:relative;color:inherit}.post-card-link:focus-visible,.pagination a:focus-visible,.category-list a:focus-visible,.mobile-categories a:focus-visible,.blog-nav a:focus-visible,.github-link:focus-visible,.article-body a:focus-visible,.toc a:focus-visible{outline:2px solid #f5b942;outline-offset:3px;z-index:2}
  .post-visual,.post-cover{height:114px;border-bottom:1px solid #292927;position:relative;overflow:hidden;background:linear-gradient(125deg,#171714,#10100f 68%)}
  .post-visual:before{content:"";position:absolute;inset:0;background-image:linear-gradient(rgb(245 185 66 / .055) 1px,transparent 1px),linear-gradient(90deg,rgb(245 185 66 / .055) 1px,transparent 1px);background-size:26px 26px;mask-image:linear-gradient(115deg,#000,transparent 75%)}
  .post-visual:after{content:"";position:absolute;width:180px;height:180px;border:1px solid #f5b94225;transform:rotate(45deg);right:36px;top:25px;box-shadow:0 0 0 24px #f5b94206,0 0 0 48px #f5b94204}
  .visual-index{position:absolute;top:14px;left:16px;font:10px "Geist Mono Variable",monospace;color:#77736a;letter-spacing:.12em}.visual-mark{position:absolute;right:28px;top:10px;font:500 65px/.9 "Martian Mono Variable",monospace;letter-spacing:-.14em;color:#e9b84e22;z-index:1}.visual-mark span{color:#f5b94277}
  .post-cover img{width:100%;height:100%;object-fit:cover;transition:transform .4s}.post-card:hover .post-cover img{transform:scale(1.035)}
  .post-content{padding:17px 17px 20px;display:flex;flex-direction:column;flex:1}.post-topline{display:flex;justify-content:space-between;gap:10px;align-items:center}.category-chip{font:500 9px "Geist Mono Variable",monospace;text-transform:uppercase;letter-spacing:.11em;color:#e9b84e}.post-index{font:9px "Geist Mono Variable",monospace;color:#5d5951;letter-spacing:.1em}
  .post-content h2{font-size:18px;line-height:1.3;font-weight:500;letter-spacing:-.025em;margin:16px 0 10px;color:#e9e6df}.post-description{font-size:12px;line-height:1.65;color:#96928a;margin:0 0 21px}.post-meta{margin-top:auto;padding-top:13px;border-top:1px solid #292927;display:flex;align-items:center;gap:9px;flex-wrap:wrap;font:9px "Geist Mono Variable",monospace;color:#77736a;text-transform:uppercase;letter-spacing:.04em}.post-meta span+span:before{content:"·";margin-right:9px;color:#504c44}.post-arrow{position:absolute;right:17px;top:128px;color:#77736a;font-size:15px;transition:color .18s,transform .18s}.post-card:hover .post-arrow{color:#f5b942;transform:translate(2px,-2px)}
  .post-card.featured .post-content h2{font-size:20px}
  .empty-state{border:1px solid #292927;padding:42px;color:#aaa69d;font-size:13px}.pagination{display:flex;align-items:center;justify-content:space-between;margin-top:30px;padding-top:18px;border-top:1px solid #292927}.pagination>a,.page-numbers a{font:10px "Geist Mono Variable",monospace;letter-spacing:.08em;color:#9b978e;text-transform:uppercase;padding:12px 8px}.pagination>a:hover,.page-numbers a:hover{color:#f5b942}.pagination .disabled{opacity:.35;pointer-events:none}.page-numbers{display:flex;gap:5px}.page-numbers a{min-width:34px;text-align:center}.page-numbers a.selected{color:#f5b942;border-bottom:1px solid #f5b942}
  .blog-footer{border-top:1px solid #292927;display:flex;justify-content:space-between;gap:20px;align-items:center;padding:23px clamp(20px,5vw,72px);font:9px "Geist Mono Variable",monospace;color:#706c64;letter-spacing:.09em;text-transform:uppercase}.blog-footer a:first-child{color:#aaa69d}.blog-footer a:last-child{color:#f5b942}
  .article-wrap{max-width:1220px;margin:auto;padding:54px clamp(20px,6vw,88px) 100px}.breadcrumbs{font:10px "Geist Mono Variable",monospace;letter-spacing:.08em;text-transform:uppercase;color:#817d74;margin-bottom:39px}.breadcrumbs a{color:#aaa69d}.breadcrumbs span{padding:0 10px;color:#5b574f}
  .article-header{max-width:800px;margin:0 auto 40px}.article-categories{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:18px}.article-categories a{font:10px "Geist Mono Variable",monospace;text-transform:uppercase;letter-spacing:.1em;color:#f5b942;border:1px solid #57472b;padding:7px 9px}.article-header h1{font-size:clamp(36px,5.5vw,68px);line-height:1.06;letter-spacing:-.055em;font-weight:450;margin:0 0 18px}.article-lede{font-size:17px;line-height:1.65;color:#aaa69d;margin:0;max-width:720px}.article-byline{display:flex;align-items:center;gap:15px;border-top:1px solid #292927;border-bottom:1px solid #292927;margin-top:29px;padding:16px 0}.author-avatar{height:38px;width:38px;object-fit:cover;border-radius:50%;background:#24231f}.author-name{font-size:12px;color:#e6e2da}.author-role{font-size:10px;color:#827e75;margin-top:4px}.article-dates{margin-left:auto;text-align:right;font:9px/1.8 "Geist Mono Variable",monospace;color:#88847b;text-transform:uppercase;letter-spacing:.04em}.article-cover{margin:36px 0 50px;border:1px solid #292927}.article-cover img{display:block;width:100%;max-height:510px;object-fit:cover}.article-columns{display:grid;grid-template-columns:minmax(0,1fr) 205px;gap:clamp(35px,6vw,86px);max-width:980px;margin:auto}.article-body{min-width:0;color:#ccc8c0;font-size:15px;line-height:1.85}.article-body h2{font-size:25px;line-height:1.25;letter-spacing:-.03em;color:#edeae3;font-weight:500;margin:2.1em 0 .65em;scroll-margin-top:26px}.article-body h3{font-size:19px;color:#edeae3;font-weight:500;margin:1.8em 0 .5em;scroll-margin-top:26px}.article-body p{margin:0 0 1.25em}.article-body a{color:#f5b942;text-decoration:underline;text-decoration-color:#f5b94266;text-underline-offset:3px}.article-body ul,.article-body ol{padding-left:1.4em;margin:0 0 1.35em}.article-body li{padding-left:.3em;margin:.35em 0}.article-body li::marker{color:#c79842}.article-body blockquote{border-left:2px solid #f5b942;margin:1.8em 0;padding:.2em 0 .2em 1.2em;color:#aaa69d}.article-body code{font: .88em "Geist Mono Variable",monospace;color:#f1ca7c;background:#1a1916;padding:.14em .32em}.article-body pre{overflow-x:auto;padding:18px;background:#10100f;border:1px solid #292927;line-height:1.65;font-size:12px;tab-size:2}.article-body pre code{background:none;padding:0;color:inherit}.article-body table{display:block;max-width:100%;overflow-x:auto;border-collapse:collapse}.article-body th,.article-body td{border:1px solid #33322e;padding:8px 11px;text-align:left}.article-body th{color:#edeae3}.article-body img{max-width:100%;height:auto}.article-body hr{border:0;border-top:1px solid #292927;margin:2em 0}.toc{position:sticky;top:24px;align-self:start;border-left:1px solid #34322d;padding-left:15px}.toc summary,.toc-title{font:10px "Geist Mono Variable",monospace;color:#aaa69d;text-transform:uppercase;letter-spacing:.12em;margin-bottom:13px}.toc ul{list-style:none;padding:0;margin:0}.toc li{margin:0 0 10px}.toc a{font-size:11px;line-height:1.5;color:#858178}.toc a:hover{color:#f5b942}.toc details>summary{display:none;cursor:pointer}.related-section,.article-neighbors{max-width:980px;margin:68px auto 0;border-top:1px solid #292927;padding-top:22px}.related-section h2,.article-neighbors h2{font:10px "Geist Mono Variable",monospace;color:#aaa69d;text-transform:uppercase;letter-spacing:.12em}.related-links{display:grid;grid-template-columns:repeat(2,1fr);gap:12px}.related-links a,.neighbor-link{border:1px solid #292927;padding:15px;color:#e6e2da;font-size:13px;line-height:1.45}.related-links a span,.neighbor-link span{display:block;font:9px "Geist Mono Variable",monospace;color:#f5b942;margin-bottom:8px;text-transform:uppercase;letter-spacing:.08em}.article-neighbors{display:flex;justify-content:space-between;gap:14px}.article-neighbors h2{width:100%}.article-neighbors>.neighbor-link{flex:1}.neighbor-link.next{text-align:right}.back-to-blog{display:inline-flex;margin-top:37px;font:10px "Geist Mono Variable",monospace;color:#f5b942;text-transform:uppercase;letter-spacing:.09em}
  @media(max-width:1100px){.post-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.blog-nav{gap:16px}.blog-nav a{font-size:10px}}
  @media(max-width:740px){.blog-header{height:auto;min-height:66px}.blog-header-inner{flex-wrap:wrap;gap:0;padding:0 18px 10px}.blog-logo{height:60px}.github-link{margin-left:auto;padding:9px;font-size:9px}.blog-nav{order:3;width:100%;overflow-x:auto;gap:22px;padding:3px 0 11px;scrollbar-width:none}.blog-nav::-webkit-scrollbar{display:none}.blog-nav a{white-space:nowrap;font-size:9px}.blog-nav .current:after{bottom:-12px}.blog-hero{min-height:340px}.blog-hero-content{padding:46px 22px}.blog-hero h1{font-size:clamp(35px,9vw,53px)}.desktop-break{display:none}.hero-description{font-size:13px;max-width:490px}.hero-atmosphere{opacity:.45;mask-image:linear-gradient(90deg,transparent,#000 40%,#000)}.hero-atmosphere svg{width:135%;right:-38%;}.blog-main{padding:31px 18px 70px}.browse-heading,.category-sidebar{display:none}.mobile-categories{display:flex;gap:7px;overflow-x:auto;margin:0 -18px 17px;padding:0 18px 12px;scrollbar-width:none}.mobile-categories::-webkit-scrollbar{display:none}.mobile-categories a{flex:0 0 auto;padding:9px 11px;border:1px solid #302f2b;color:#9b978e;font:9px "Geist Mono Variable",monospace;text-transform:uppercase;letter-spacing:.07em}.mobile-categories a[aria-current=page]{color:#f5b942;border-color:#755a2b}.post-grid{grid-template-columns:1fr;gap:11px}.post-card-link{min-height:0}.post-visual,.post-cover{height:132px}.post-content{padding:15px 15px 17px}.post-content h2{font-size:19px;margin-top:13px}.post-arrow{top:145px}.pagination{margin-top:20px}.pagination>a{font-size:9px}.page-numbers{gap:0}.page-numbers a{min-width:29px}.blog-footer{flex-wrap:wrap;font-size:8px}.blog-footer span{order:3;width:100%}.article-wrap{padding:32px 20px 70px}.breadcrumbs{margin-bottom:28px}.article-header h1{font-size:clamp(37px,10vw,55px)}.article-lede{font-size:15px}.article-byline{gap:10px}.article-dates{font-size:8px}.article-columns{display:flex;flex-direction:column;gap:18px}.toc{position:static;border:1px solid #292927;padding:0;width:100%;order:-1}.toc details>summary{display:block;list-style:none;padding:13px 14px;margin:0}.toc details>summary::-webkit-details-marker{display:none}.toc details>summary:after{content:'+';float:right;color:#f5b942}.toc details[open]>summary:after{content:'−'}.toc details ul{padding:0 14px 12px}.toc details ul li:last-child{margin-bottom:0}.toc .toc-title{display:none}.toc:not(:has(details)) ul{padding:13px}.article-body{font-size:14px}.article-body h2{font-size:23px}.article-cover{margin:26px 0 32px}.related-links{grid-template-columns:1fr}.article-neighbors{margin-top:45px}.related-section{margin-top:45px}}
  @media(prefers-reduced-motion:reduce){.network-lines,.particle-path{animation:none}.post-card,.post-cover img{transition:none}}

  /* Editorial surfaces carry the same graphite depth as Hive's landing hero. */
  .blog-site{background:radial-gradient(ellipse 105% 82% at 50% 8%,#252523 0%,#1e1e1c 34%,#171716 68%,#121211 100%);background-attachment:fixed}
  .blog-header{background:rgb(28 28 26 / .88);border-color:rgb(237 234 227 / .13)}
  .blog-hero{background:linear-gradient(110deg,rgb(255 255 255 / .018),transparent 55%);border-color:rgb(237 234 227 / .14)}
  .blog-main{padding-bottom:84px}
  .browse-heading{border-color:#3a3a37;color:#89867e}
  .category-list a:hover,.category-list a[aria-current=page]{background:rgb(255 255 255 / .045)}
  .post-card{background:rgb(29 29 27 / .88);border-color:#3a3a37}
  .post-card:hover{background:#242421;border-color:#615744}
  .post-visual,.post-cover{background:linear-gradient(125deg,#2b2b28,#1d1d1b 72%);border-color:#3a3a37}
  .post-visual:before{background-image:linear-gradient(rgb(245 185 66 / .065) 1px,transparent 1px),linear-gradient(90deg,rgb(245 185 66 / .065) 1px,transparent 1px)}
