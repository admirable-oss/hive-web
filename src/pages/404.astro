---
import { cn } from "cn";
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/layout/PageHeader.astro";
import { Logo } from "../components/brand/Logo";
import { buttonVariants } from "../components/ui/button";
import { LINKS } from "../lib/site";
---

<Layout title="404 — Cell not found · Hive" description="This page doesn’t exist. The hive keeps going." noindex lockScroll>
  <main
    class="relative flex h-dvh flex-col overflow-hidden bg-[radial-gradient(ellipse_95%_80%_at_50%_44%,#1E1E1C_0%,#151514_52%,#0C0C0B_100%)] font-sans text-bone"
  >
    <div aria-hidden="true" class="scanlines pointer-events-none absolute inset-0 opacity-50"></div>
    <PageHeader />

    <section
      class="relative mx-auto flex w-full max-w-[1200px] flex-1 flex-col items-start justify-center gap-6 px-5 pb-[calc(32px+env(safe-area-inset-bottom))] sm:items-center sm:px-[clamp(16px,4vw,64px)] sm:text-center"
    >
      <Logo variant="mark" title="" className="h-16 w-auto sm:h-24" />
      <p class="m-0 flex items-center gap-3 font-mono text-[11px] tracking-[.24em] text-stone sm:text-xs">
        <span aria-hidden="true" class="size-2 bg-honey"></span>ERR 404 · CELL NOT FOUND
      </p>
      <h1 class="m-0 font-display text-[length:min(11vw,56px)] leading-[1.05] font-normal tracking-[-.06em] sm:text-[length:min(6vw,10vh,84px)]">
        This cell is empty<span class="text-honey">.</span>
      </h1>
      <p class="m-0 max-w-[44ch] text-base leading-normal text-pretty text-stone sm:text-lg">
        The page you’re after drifted off — but the hive keeps going.
      </p>
      <pre
        class="m-0 w-full max-w-[520px] overflow-x-auto border border-bone/12 bg-[rgb(15_15_14/.88)] px-5 py-4 text-left font-mono text-[13px] leading-relaxed sm:text-sm"><span class="text-honey">$</span> hive attach <span class="text-fog" data-missing-path>/missing</span>
<span class="text-[#E05252]">error:</span> <span class="text-stone">no such cell — try</span> <span class="text-bone">hive ls</span></pre>
      <div class="flex w-full flex-col gap-2.5 sm:w-auto sm:flex-row">
        <a href="/" class={cn(buttonVariants({ variant: "inverse", size: "lg" }), "hover:bg-honey hover:text-ink")}>Back to the hive</a>
        <a href={LINKS.docs} class={cn(buttonVariants({ variant: "secondary", size: "lg" }), "font-normal hover:border-bone/40 hover:text-bone")}>
          Read the docs <span aria-hidden="true">↗</span>
        </a>
      </div>
    </section>
  </main>
  <!-- Prerendered 404: show the path the visitor actually requested. -->
  <script is:inline>
    document.querySelector("[data-missing-path]").textContent = location.pathname;
  </script>
</Layout>
