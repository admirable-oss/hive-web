---
import { getCollection } from 'astro:content';
import BlogFrame from '../../../../components/blog/BlogFrame.astro';
import BlogHero from '../../../../components/blog/BlogHero.astro';
import BlogPostCard from '../../../../components/blog/BlogPostCard.astro';
import BlogPagination from '../../../../components/blog/BlogPagination.astro';
import BlogSortControl from '../../../../components/blog/BlogSortControl.astro';
import { BLOG_PAGE_SIZE, categoriesFor, publishedPosts, sortModesFor, sortPosts, type BlogSortMode, categoryUrl } from '../../../../lib/blog';

export async function getStaticPaths() {
  const posts = publishedPosts(await getCollection('blog'));
  return sortModesFor(posts).filter((mode) => mode !== 'latest').map((sort) => ({ params: { sort } }));
}

const sort = Astro.params.sort as BlogSortMode;
const allPosts = publishedPosts(await getCollection('blog'));
const posts = sortPosts(allPosts, sort);
const categories = categoriesFor(allPosts);
const totalPages = Math.ceil(posts.length / BLOG_PAGE_SIZE);
const pagePosts = posts.slice(0, BLOG_PAGE_SIZE);
const base = `/blog/sort/${sort}`;
const canonical = new URL(`${base}/`, Astro.site).href;
const sortLabel: Record<BlogSortMode, string> = { latest: 'Latest', oldest: 'Oldest', shortest: 'Shortest read', longest: 'Longest read', title: 'Title A–Z', 'most-read': 'Most read' };
---
<BlogFrame title={`Hive Blog — ${sortLabel[sort]}`} description={`Hive field notes sorted by ${sortLabel[sort].toLowerCase()}.`} canonical={canonical} noindex>
  <BlogHero count={allPosts.length} eyebrow={`FIELD NOTES / ${sortLabel[sort].toUpperCase()}`} />
  <main class="blog-main"><div class="blog-layout">
    <aside class="category-sidebar" aria-label="Article categories"><p class="browse-heading">BROWSE / {allPosts.length}</p><nav class="category-list"><a href="/blog"><span>All articles</span><span>{allPosts.length}</span></a>{categories.map((category) => <a href={categoryUrl(category.slug)}><span>{category.name}</span><span>{category.count}</span></a>)}</nav></aside>
    <section aria-label={`Articles sorted by ${sortLabel[sort]}`}>
      <nav class="mobile-categories" aria-label="Filter articles by category"><a href="/blog">All / {allPosts.length}</a>{categories.map((category) => <a href={categoryUrl(category.slug)}>{category.name} / {category.count}</a>)}</nav>
      <BlogSortControl posts={allPosts} base="/blog" current={sort} />
      {pagePosts.length ? <div class="post-grid">{pagePosts.map((post) => <BlogPostCard post={post} />)}</div> : <p class="empty-state">No articles have been published yet. Check back soon.</p>}
      <BlogPagination current={1} total={totalPages} base={base} />
    </section>
  </div></main>
</BlogFrame>
