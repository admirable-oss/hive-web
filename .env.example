PUBLIC_POSTHOG_PROJECT_TOKEN=your_posthog_project_token_here
PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# GitHub token (server-only), used by /roadmap and the landing's repo stats.
# Without it GitHub allows 60 requests/hour per server IP. A fine-grained token
# with public-repository read access is enough. Set it in Vercel → Settings → Environment Variables.
GITHUB_TOKEN=

# Ask Bee, the docs assistant (server-only). Without a key the drawer says it
# isn't connected. Get one at https://aistudio.google.com/apikey and set it in
# Vercel → Settings → Environment Variables.
GEMINI_API_KEY=

# ASK_BEE_PROVIDER=gemini
# ASK_BEE_MODEL=gemini-flash-lite-latest
