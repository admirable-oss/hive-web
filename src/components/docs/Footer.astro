---
import { REPO } from "@/lib/site";
import Pagination from "./Pagination.astro";

const { entry } = Astro.locals.starlightRoute;
const source = entry.data.source ?? REPO;
---

{
  !entry.data.hero && (
    <footer class="article-footer">
      <Pagination />
      <div class="feedback print:hidden">
        <span>Something wrong or missing on this page?</span>
        <div class="links">
          <a href={`${REPO}/issues/new`} target="_blank" rel="noopener">Open an issue ↗</a>
          <a href={source} target="_blank" rel="noopener">View source ↗</a>
        </div>
      </div>
    </footer>
  )
}

<style>
  .article-footer {
    margin-top: 56px;
  }
  .feedback {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 24px;
    margin-top: 28px;
    padding-top: 20px;
    border-top: 1px solid #1c1c1a;
    font-size: 14px;
    color: #8f8b82;
  }
  .links {
    display: flex;
    gap: 20px;
    font-family: var(--sl-font-mono);
    font-size: 12.5px;
  }
  a {
    color: #b5b1a8;
    text-decoration: none;
  }
  a:hover {
    color: #f5b942;
  }
</style>
